{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skills Installer",
  "version": "0.1.0",
  "identifier": "com.example.skills-installer",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skills Installer",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "Skills Installer Contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "category": "Development",
    "shortDescription": "Discover, configure, and install agent skills",
    "longDescription": "Skills Installer maintains a curated remote and local Skill catalog, reusable Tags, and project or global installation targets for supported coding agents.",
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
