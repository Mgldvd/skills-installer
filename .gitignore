# Rust
/src-tauri/target/

# Frontend
/frontend/node_modules/

# Tauri-generated (regenerated by `tauri dev`/`tauri build`)
/src-tauri/gen/

# Everything else generated by a build/test/smoke run and not versioned —
# frontend build output, packaged installers, the skill-lifecycle test
# fixture root, the `task smoke` scratch dir. See taskfile.yml and
# src-tauri/tests/skill_lifecycle.rs.
/.generated/

# Editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp

# Logs
*.log
npm-debug.log*

.claude/
.agents/

.env
